<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EasyShop.ViewModels"
             xmlns:models="clr-namespace:EasyShop.Models"
             x:Class="EasyShop.Views.ProductsPage"
             x:DataType="vm:ProductsViewModel"
             Title="Produtos (NoSQL)">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Entry Placeholder="Nome do produto" Text="{Binding Name}" />
            <Entry Placeholder="Preço (ex.: 199,90)" Keyboard="Numeric" Text="{Binding Price}" />
            <Editor Placeholder="Atributos opcionais, um por linha (Cor: Azul)"
                    Text="{Binding Attributes}" HeightRequest="90" AutoSize="TextChanges" />
            <Button Text="Salvar produto" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Message}" FontAttributes="Italic" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Products}">
            <CollectionView.EmptyView>
                <Label Text="Nenhum produto cadastrado." HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding PriceDisplay}" />
                            <Label Text="{Binding AttributesSummary}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
